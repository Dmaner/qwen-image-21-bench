+def metrics_to_json(value):
+    """Serialize metadata only after wall timing; never copy a Tensor to CPU."""
+    import dataclasses
+    import math
+    from collections.abc import Mapping
+    if value is None or isinstance(value, (str, bool, int)):
+        return value
+    if isinstance(value, float):
+        return value if math.isfinite(value) else {"nonfinite_float": str(value)}
+    if isinstance(value, Mapping):
+        return {str(k): metrics_to_json(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [metrics_to_json(v) for v in value]
+    if dataclasses.is_dataclass(value) and not isinstance(value, type):
+        return {field.name: metrics_to_json(getattr(value, field.name)) for field in dataclasses.fields(value)}
+    if callable(getattr(value, "model_dump", None)):
+        return metrics_to_json(value.model_dump(mode="python"))
+    if callable(getattr(value, "dict", None)):
+        return metrics_to_json(value.dict())
+    return {"unsupported_metadata_type": type(value).__module__ + "." + type(value).__name__}
+
